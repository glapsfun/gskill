# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# GoReleaser build output
/dist/

# Generated npm packages (npm/scripts/build-packages.mjs)
/npm/dist/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Project-local pinned dev tools (installed by scripts/bootstrap.sh)
/bin/

# SDD
.superpowers
specs
.specify/*
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md
.docs
.sddx
docs/pm
t1

# AI
# .claude stays local, except the release-guru skill: it is the release runbook
# every agent cutting a gskill release needs, so it is versioned with the repo.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/release-guru/
.codex
.gskill
CLAUDE.md
.agents
skills-lock.json
.gskill/

# Documentation site (website/): dependencies, build output, and the content
# tree cmd/gen-site regenerates from docs/ on every build.
/website/node_modules/
/website/dist/
/website/.astro/
/website/src/content/docs/
/website/src/generated/
/website/public/docs-assets/
