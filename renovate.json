{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep .config/tool-versions pins current (Dependabot owns gomod + actions).",
      "managerFilePatterns": ["/(^|/)\\.config/tool-versions$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Keep the .ko.yaml base image digest current.",
      "managerFilePatterns": ["/(^|/)\\.ko\\.yaml$/"],
      "matchStrings": [
        "defaultBaseImage: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [".ko.yaml"],
      "schedule": ["before 6am on monday"]
    }
  ]
}
